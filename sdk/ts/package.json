{
  "name": "olayer-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Olayer GIS ATC Framework",
  "main": "./dist/olayer.js",
  "module": "./dist/olayer.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "wasm/pkg"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/olayer.js",
      "require": "./dist/olayer.umd.cjs",
      "default": "./dist/olayer.js"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --emitDeclarationOnly --noImplicitOverride false && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "olayer-wasm": "file:./wasm/pkg",
    "pbf": "^5.1.2"
  },
  "devDependencies": {
    "canvas": "^3.2.3",
    "jsdom": "^29.1.1",
    "puppeteer": "^25.1.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-top-level-await": "^1.4.1",
    "vite-plugin-wasm": "^3.0.1",
    "vitest": "^4.1.8"
  }
}
